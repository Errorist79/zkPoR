# TEST ONLY. The soundness gate must produce the same salts on every run, so it
# reads this fixed value. The bytes are the ASCII string of the name below.
#
# A real authority reads its master secret from the operating system random
# source, keeps it confidential, and never writes it into a repository. A leaked
# master secret exposes every leaf of every context that used it.
TEST_ONLY_MASTER_SECRET=0x7a6b706f722d746573742d6f6e6c792d6d61737465722d736563726574212121
