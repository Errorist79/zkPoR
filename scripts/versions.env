# Single source of truth for pinned, spike-verified toolchain versions.
# Sourced by scripts/setup.sh and circuits/scripts/build_all.sh.

# Noir / Barretenberg (proof + VK generation)
NARGO_VERSION="1.0.0-beta.9"
BB_VERSION="v0.87.0"
NOIR_POSEIDON_VERSION="v0.2.0"
# In-circuit recursive UltraHonk verification dep used by the aggregator circuit
# (circuits/recursion/agg). Read at the SAME tag as bb so its proof/vk field
# encodings match the prover: format-determining (456-field proof / 112-field vk
# at bb 0.87.0). Pinned in circuits/recursion/agg/Nargo.toml.
BB_PROOF_VERIFICATION_VERSION="v0.87.0"

# Rust / Soroban
RUST_VERSION="1.96.0"
SOROBAN_SDK_VERSION="26.0.1"
# Host-side Poseidon2 used by tools/recursion-gen to reproduce the in-circuit
# subroot off-circuit. Must match the on-chain Poseidon2 the verifier uses.
SOROBAN_POSEIDON_VERSION="26.0.0"

# Stellar CLI must match the network protocol (P26). 22.x emits invalid XDR
# against a Protocol 26 network; 27.x targets Protocol 27. Use 26.1.0.
STELLAR_CLI_VERSION="26.1.0"

# Localnet (quickstart "future" tag runs Protocol 26, where CAP-0080 BN254
# host functions are available).
QUICKSTART_IMAGE_TAG="future"
PROTOCOL_VERSION="26"

# Host-accelerated UltraHonk verifier upstream provenance (audit trail). The
# PRODUCTION build now uses the in-repo VENDORED copy at
# contracts/vendor/ultrahonk-soroban-verifier (with the completed-pairing patch
# applied to src/verifier.rs), NOT this git rev. These vars record the upstream
# repo + rev the vendored copy was taken from; the spikes gate still clones this
# rev as its scratch base.
ULTRAHONK_VERIFIER_GIT="https://github.com/yugocabrio/ultrahonk-rust-verifier.git"
ULTRAHONK_VERIFIER_REV="661db07200f890b1bd9a7349ed787c70a706dd12"
